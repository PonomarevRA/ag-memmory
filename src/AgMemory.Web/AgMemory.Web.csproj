<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgMemory.Web</RootNamespace>
    <Description>Vite SPA host for AgMemory.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Web host is the concrete LanceDB composition root; Contracts and Core remain provider-neutral. -->
    <PackageReference Include="Apache.Arrow" />
    <PackageReference Include="LanceDB" />
    <ProjectReference Include="../AgMemory.Contracts/AgMemory.Contracts.csproj" />
    <ProjectReference Include="../AgMemory.Core/AgMemory.Core.csproj" />
    <ProjectReference Include="../AgMemory.Storage.LanceDb/AgMemory.Storage.LanceDb.csproj" />
  </ItemGroup>

  <Target Name="BuildWebClient" BeforeTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)/client/package.json')">
    <Message Importance="high" Text="Building AgMemory Web Vite client..." />
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)/client" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)/client" />
    <Exec Command="npm test" WorkingDirectory="$(MSBuildProjectDirectory)/client" />
  </Target>

</Project>
