{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ModelGateway": {
    "Mode": "OpenAiCompatible",
    "Endpoint": "http://127.0.0.1:8081/v1/chat/completions",
    "Model": "small-yuki-local",
    "ApiKey": "local-loopback",
    "MaxOutputTokens": 512,
    "DisableThinking": true
  },
  "MemoryGraph": {
    "Enabled": true,
    "ActorId": "local-development",
    "Scope": {
      "TenantId": "local-development"
    }
  },
  "MemoryReader": {
    "Enabled": true,
    "ActorId": "local-development",
    "Scope": {
      "TenantId": "local-development"
    }
  }
}
