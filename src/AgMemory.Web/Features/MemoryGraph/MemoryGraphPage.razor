@page "/memory-graph"
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Граф памяти · AgMemory</PageTitle>

<section class="memory-graph-page">
    <header class="page-header">
        <p class="eyebrow">Локальная диагностика</p>
        <h1>Граф памяти</h1>
        <p>Визуализация показывает только типы и агрегированные связи между memory. Текст memory, сущности, scope и постоянные идентификаторы не отправляются в браузер.</p>
    </header>

    @if (_loading && _graph is null)
    {
        <UiStatusBanner Kind="UiStatusKind.Info" Title="Загрузка графа">
            Запрашивается ограниченный локальный снимок.
        </UiStatusBanner>
    }
    else if (!IsAvailable)
    {
        <UiStatusBanner Kind="UiStatusKind.Warning" Title="Граф памяти недоступен">
            Визуализация доступна только из loopback в Development при явно настроенном локальном scope.
            <button class="ui-button ui-button--secondary" type="button" @onclick="LoadAsync">Повторить</button>
        </UiStatusBanner>
    }
    else if (_graph!.Nodes.Count == 0)
    {
        <UiStatusBanner Kind="UiStatusKind.Info" Title="Нет подходящих memory">
            Для настроенного scope не найдено active и неистекших записей.
        </UiStatusBanner>
    }
    else
    {
        <section class="memory-graph-card" aria-label="Интерактивная вселенная памяти" aria-busy="@_loading">
            <div class="memory-graph-toolbar" aria-label="Управление масштабом графа">
                <button class="ui-button ui-button--secondary" type="button" @onclick="ZoomInAsync">Увеличить</button>
                <button class="ui-button ui-button--secondary" type="button" @onclick="ZoomOutAsync">Уменьшить</button>
                <button class="ui-button ui-button--ghost" type="button" @onclick="ResetAsync">Сбросить вид</button>
                <button class="ui-button ui-button--ghost" type="button" @onclick="LoadAsync" disabled="@_loading">Обновить</button>
                @if (!string.IsNullOrWhiteSpace(_graph.NextToken))
                {
                    <button class="ui-button" type="button" @onclick="LoadMoreAsync" disabled="@_loading">Показать ещё 25</button>
                }
            </div>
            <div class="memory-graph-stage">
                <div class="memory-graph-scene">
                    <canvas @ref="_canvas" class="memory-graph-canvas" tabindex="0" role="img" aria-label="Интерактивная трёхмерная карта графа памяти" aria-describedby="memory-graph-scene-description memory-graph-selection memory-graph-summary">
                        Ваш браузер не поддерживает canvas. Текстовое описание графа находится ниже.
                    </canvas>
                    <canvas @ref="_fallbackCanvas" class="memory-graph-canvas" hidden tabindex="-1" role="img" aria-hidden="true" aria-label="Совместимая двумерная карта графа памяти" aria-describedby="memory-graph-summary">
                        Ваш браузер не поддерживает canvas. Текстовое описание графа находится ниже.
                    </canvas>
                    @if (_loading)
                    {
                        <div class="memory-graph-loading-overlay" role="status" aria-live="polite">
                            Добавляется следующая порция графа.
                        </div>
                    }
                    <p id="memory-graph-scene-description" class="visually-hidden">Узлы можно выбирать касанием или щелчком. Перетаскивайте сцену для обзора, используйте колесо для масштаба. Клавиши стрелок, Q и E меняют положение камеры, плюс и минус меняют масштаб, Home или 0 возвращают исходный вид, Escape снимает выбор.</p>
                </div>
                <aside class="memory-graph-inspector" aria-label="Инспектор и легенда карты">
                    <section>
                        <h2>Выбор</h2>
                        <p id="memory-graph-selection" @ref="_selectionSummary" class="memory-graph-selection" aria-live="polite">Нет выбранного узла. Выберите узел, чтобы увидеть его безопасные агрегированные свойства и ближайшее окружение.</p>
                    </section>
                    <details class="memory-graph-legend" open>
                        <summary>Как читать карту</summary>
                        <ul>
                            <li>Форма и цвет обозначают тип memory.</li>
                            <li>Размер узла показывает степень, внутренний акцент — важность.</li>
                            <li>Яркость и кольцо показывают диапазон уверенности.</li>
                            <li>Нейтральные линии — агрегированные <code>SharedEntity</code>-связи.</li>
                        </ul>
                        <p class="small-copy">Глубина, расстояние и расположение служат только для обзора структуры. Они не выражают близость, причинность, время или тип отношения.</p>
                    </details>
                </aside>
            </div>
        </section>

        <section id="memory-graph-summary" class="memory-graph-summary" aria-live="polite">
            <h2>Текстовое описание</h2>
            <p>Узлов: @_graph.Nodes.Count. Связей: @_graph.Edges.Count. Связь <code>SharedEntity</code> означает совпадение нормализованной сущности; её имя не показывается.</p>
            <ul class="memory-graph-summary__nodes">
                @foreach (var node in _graph.Nodes)
                {
                    <li @key="node.Id">
                        <button class="memory-graph-summary__node" type="button" @onclick="() => SelectNodeAsync(node.Id)">
                            <strong>@node.Type</strong> · степень @node.Degree · важность @node.ImportanceBand/5 · уверенность @node.ConfidenceBand/5
                        </button>
                    </li>
                }
            </ul>
            @if (_graph.Edges.Count > 0)
            {
                <h3>Агрегированные связи</h3>
                <ul class="memory-graph-summary__edges">
                    @foreach (var edge in _graph.Edges)
                    {
                        <li @key="EdgeKey(edge)">@LabelFor(edge.SourceId) — @LabelFor(edge.TargetId) · @edge.Kind · вес @edge.Weight</li>
                    }
                </ul>
            }
        </section>
    }
</section>

@code {
    private ElementReference _canvas;
    private ElementReference _fallbackCanvas;
    private ElementReference _selectionSummary;
    private MemoryGraphInterop? _interop;
    private MemoryGraphApiResponse? _graph;
    private bool _loading = true;
    private bool _canvasInitialized;

    private bool IsAvailable => string.Equals(_graph?.Status, "available", StringComparison.Ordinal);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _interop = new(JS);
            await LoadAsync();
            return;
        }

        if (!_loading && IsAvailable && !_canvasInitialized && _interop is not null)
        {
            await _interop.InitializeAsync(_canvas, _fallbackCanvas, _selectionSummary);
            _canvasInitialized = true;
            await _interop.RenderAsync(_graph!);
        }
    }

    private async Task LoadAsync()
    {
        if (_interop is null)
            return;

        _canvasInitialized = false;
        _loading = true;
        await InvokeAsync(StateHasChanged);
        _graph = await _interop.LoadAsync();
        _loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadMoreAsync()
    {
        if (_interop is null || _graph?.NextToken is not { } token) return;
        _loading = true;
        await InvokeAsync(StateHasChanged);
        _graph = await _interop.LoadAsync(token);
        _loading = false;
        if (IsAvailable && _canvasInitialized)
            await _interop.RenderAsync(_graph!, preserveView: true);
        await InvokeAsync(StateHasChanged);
    }

    private async Task ZoomInAsync()
    {
        if (_interop is not null)
            await _interop.ZoomInAsync();
    }

    private async Task ZoomOutAsync()
    {
        if (_interop is not null)
            await _interop.ZoomOutAsync();
    }

    private async Task ResetAsync()
    {
        if (_interop is not null)
            await _interop.ResetAsync();
    }

    private async Task SelectNodeAsync(string id)
    {
        if (_interop is not null)
            await _interop.SelectNodeAsync(id);
    }

    private string LabelFor(string id) => _graph?.Nodes.FirstOrDefault(node => node.Id == id)?.Type ?? "Узел";

    private static string EdgeKey(MemoryGraphEdgeDto edge) => $"{edge.SourceId}:{edge.TargetId}";

    public async ValueTask DisposeAsync()
    {
        if (_interop is not null)
            await _interop.DisposeAsync();
    }
}
