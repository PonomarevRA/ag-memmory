@page "/chat"
@page "/chat/{ThreadId}"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject BrowserStateInterop BrowserState
@inject IModelChatGateway Gateway

<PageTitle>Чат · AgMemory</PageTitle>

<section class="chat-page">
    <header class="page-header page-header--chat">
        <div>
            <p class="eyebrow">Локальный thread</p>
            <h1>Чат с моделью</h1>
            <p>Переписка хранится только в этом браузере. AgMemory не создаёт memory из сообщений автоматически.</p>
        </div>
        <div class="button-row">
            <button class="ui-button ui-button--secondary" type="button" @onclick="StartNewThread">Новый чат</button>
            <button class="ui-button ui-button--ghost" type="button" @onclick="ClearThreadAsync" disabled="@(!_ready || _messages.Count == 0)">Удалить thread</button>
        </div>
    </header>

    @if (!_gatewayStatus.IsAvailable)
    {
        <UiStatusBanner Kind="UiStatusKind.Warning" Title="Модель не настроена">
            <p>Отправка покажет безопасный статус недоступности. Для подключения задайте на сервере переменные окружения и перезапустите хост:</p>
            <UiCodeSnippet Code="@ModelGatewayEnvironmentExample" />
            <p><code>ModelGateway__Endpoint</code> должен указывать на OpenAI-compatible Chat Completions URL выбранного провайдера. Ключ не вводится в браузере и не добавляется в <code>appsettings.json</code> или репозиторий.</p>
        </UiStatusBanner>
    }
    else if (_gatewayStatus.IsDemo)
    {
        <UiStatusBanner Kind="UiStatusKind.Info" Title="Демонстрационный режим">
            Ответы детерминированные и не являются ответами внешней модели.
        </UiStatusBanner>
    }

    @if (_storageUnavailable)
    {
        <UiStatusBanner Kind="UiStatusKind.Warning" Title="Локальное сохранение недоступно">
            Чат продолжит работать в текущей вкладке, но история не переживёт перезагрузку.
        </UiStatusBanner>
    }

    @if (_lastError is { } error)
    {
        <UiStatusBanner Kind="UiStatusKind.Error" Title="Не удалось завершить ответ">
            @ErrorText(error)
            @if (!string.IsNullOrWhiteSpace(_retryPrompt))
            {
                <button class="inline-action" type="button" @onclick="RetryAsync">Повторить</button>
            }
        </UiStatusBanner>
    }

    <div class="chat-layout">
        <aside class="thread-rail" aria-label="Управление чатом">
            <p class="scope-badge">Thread · @_activeThread[..8]</p>
            <p class="muted">Локальная история</p>
            <p class="small-copy">Отправляется только текущий prompt и непрозрачный идентификатор thread.</p>
            <NavLink class="ui-button ui-button--ghost" href="/history">История посещений</NavLink>
        </aside>

        <section class="chat-panel" aria-label="Сообщения чата">
            @if (!_ready)
            {
                <div class="message-skeleton" aria-label="Загрузка локальной переписки"></div>
            }
            else if (_messages.Count == 0)
            {
                <UiEmptyState Icon="✦" Title="Начните диалог" Description="Введите вопрос. Сохранённый transcript остаётся локальным и не становится memory." />
            }
            else
            {
                <div class="message-list" aria-live="polite" aria-relevant="additions text">
                    @foreach (var message in _messages)
                    {
                        <article class="message message--@message.Role" @key="message.Id">
                            <p class="message__label">@(message.Role == "user" ? "Вы" : "Модель")</p>
                            <p class="message__content">@message.Content</p>
                        </article>
                    }
                </div>
            }

            <form class="composer" @onsubmit="SendAsync" @onsubmit:preventDefault="true">
                <label class="visually-hidden" for="chat-prompt">Сообщение модели</label>
                <textarea id="chat-prompt" class="composer__input" @bind="_prompt" @bind:event="oninput" maxlength="@ChatEndpoint.MaximumPromptLength" placeholder="Спросите модель…" disabled="@_isSending"></textarea>
                <div class="composer__footer">
                    <span class="muted">@_prompt.Length / @ChatEndpoint.MaximumPromptLength</span>
                    @if (_isSending)
                    {
                        <button class="ui-button ui-button--danger" type="button" @onclick="StopAsync">Остановить</button>
                    }
                    else
                    {
                        <button class="ui-button" type="submit" disabled="@(!_ready || string.IsNullOrWhiteSpace(_prompt))">Отправить</button>
                    }
                </div>
            </form>
        </section>
    </div>
</section>

@code {
    [Parameter] public string? ThreadId { get; set; }

    private readonly List<LocalChatMessage> _messages = [];
    private ChatGatewayStatus _gatewayStatus;
    private ChatInterop? _chatInterop;
    private DotNetObjectReference<ChatPage>? _receiver;
    private string _activeThread = Guid.NewGuid().ToString("N");
    private string _prompt = string.Empty;
    private string? _pendingAssistantId;
    private string? _retryPrompt;
    private ChatGatewayErrorCode? _lastError;
    private bool _ready;
    private bool _loadRequested = true;
    private bool _isSending;
    private bool _storageUnavailable;

    private const string ModelGatewayEnvironmentExample = """
        ModelGateway__Mode=OpenAiCompatible
        ModelGateway__Endpoint=<OpenAI-compatible Chat Completions URL>
        ModelGateway__Model=<имя модели>
        ModelGateway__ApiKey=<секретный ключ провайдера>
        # Только для small-yuki / Qwen через llama-server:
        ModelGateway__DisableThinking=true
        """;

    public ChatPage() => _gatewayStatus = new(false, false, "Модель не настроена");

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(ThreadId))
            return;

        try
        {
            var safeId = BrowserStateInterop.SanitizeThreadId(ThreadId);
            if (!string.Equals(_activeThread, safeId, StringComparison.Ordinal))
            {
                _activeThread = safeId;
                _messages.Clear();
                _prompt = string.Empty;
                _lastError = null;
                _loadRequested = true;
            }
        }
        catch (ArgumentException)
        {
            Navigation.NavigateTo($"/chat/{Guid.NewGuid():N}", replace: true);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _chatInterop = new(JS);
            _receiver = DotNetObjectReference.Create(this);
            _storageUnavailable = !await BrowserState.IsStorageAvailableAsync();
            _gatewayStatus = Gateway.GetStatus();

            if (string.IsNullOrWhiteSpace(ThreadId))
            {
                Navigation.NavigateTo($"/chat/{_activeThread}", replace: true);
                return;
            }
        }

        if (_loadRequested && !string.IsNullOrWhiteSpace(ThreadId))
        {
            _loadRequested = false;
            _messages.Clear();
            _messages.AddRange(await BrowserState.LoadThreadAsync(_activeThread));
            _ready = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SendAsync()
    {
        var prompt = _prompt.Trim();
        if (prompt.Length == 0 || prompt.Length > ChatEndpoint.MaximumPromptLength || _isSending || _chatInterop is null || _receiver is null)
            return;

        _lastError = null;
        _retryPrompt = prompt;
        _isSending = true;
        _prompt = string.Empty;
        _messages.Add(new(Guid.NewGuid().ToString("N"), "user", prompt, DateTimeOffset.UtcNow));
        _pendingAssistantId = Guid.NewGuid().ToString("N");
        _messages.Add(new(_pendingAssistantId, "assistant", "", DateTimeOffset.UtcNow));
        await _chatInterop.BeginAsync(new(_activeThread, prompt), _receiver);
    }

    private async Task RetryAsync()
    {
        if (string.IsNullOrWhiteSpace(_retryPrompt))
            return;

        _prompt = _retryPrompt;
        await SendAsync();
    }

    private async Task StopAsync()
    {
        if (_chatInterop is not null)
            await _chatInterop.StopAsync();
    }

    private void StartNewThread() => Navigation.NavigateTo($"/chat/{Guid.NewGuid():N}");

    private async Task ClearThreadAsync()
    {
        await BrowserState.ClearThreadAsync(_activeThread);
        _messages.Clear();
        _lastError = null;
        _retryPrompt = null;
    }

    [JSInvokable]
    public async Task OnChatEvent(ChatGatewayEvent item)
    {
        if (item.Kind == ChatGatewayEventKind.Text && _pendingAssistantId is { } pendingId)
        {
            var index = _messages.FindIndex(message => message.Id == pendingId);
            if (index >= 0)
                _messages[index] = _messages[index] with { Content = _messages[index].Content + item.Text };
        }
        else if (item.Kind == ChatGatewayEventKind.Error)
        {
            _lastError = item.ErrorCode ?? ChatGatewayErrorCode.Unavailable;
            RemoveEmptyPendingMessage();
        }

        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnChatCompleted()
    {
        _isSending = false;
        _pendingAssistantId = null;
        await BrowserState.SaveThreadAsync(_activeThread, _messages);
        await InvokeAsync(StateHasChanged);
    }

    private void RemoveEmptyPendingMessage()
    {
        if (_pendingAssistantId is not { } pendingId)
            return;

        _messages.RemoveAll(message => message.Id == pendingId && string.IsNullOrEmpty(message.Content));
    }

    private static string ErrorText(ChatGatewayErrorCode error) => error switch
    {
        ChatGatewayErrorCode.InvalidInput => "Сообщение не прошло локальную проверку. Сократите текст и повторите попытку.",
        ChatGatewayErrorCode.Unauthorized => "Сервер не авторизован для работы с моделью.",
        ChatGatewayErrorCode.RateLimited => "Модель временно ограничила запросы. Повторите позже.",
        ChatGatewayErrorCode.Timeout => "Модель не успела ответить. Повторите запрос.",
        ChatGatewayErrorCode.Interrupted => "Генерация остановлена.",
        _ => "Сервис модели недоступен или не настроен."
    };

    public async ValueTask DisposeAsync()
    {
        _receiver?.Dispose();
        if (_chatInterop is not null)
            await _chatInterop.DisposeAsync();
    }
}
