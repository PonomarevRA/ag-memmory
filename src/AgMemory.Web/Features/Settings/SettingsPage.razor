@page "/settings"
@inject BrowserStateInterop BrowserState

<PageTitle>Настройки · AgMemory</PageTitle>

<section class="page-header">
    <p class="eyebrow">Локальные предпочтения</p>
    <h1>Настройки интерфейса</h1>
    <p>Эти настройки сохраняются только в браузере и не передаются модели или AgMemory storage.</p>
</section>

<UiCard Class="settings-card">
    <div class="settings-row">
        <div>
            <h2>Тема</h2>
            <p class="muted">Выберите системную, светлую или тёмную тему.</p>
        </div>
        <select class="ui-select" @bind="_theme" @bind:after="SaveAsync" aria-label="Тема интерфейса">
            <option value="system">Системная</option>
            <option value="light">Светлая</option>
            <option value="dark">Тёмная</option>
        </select>
    </div>
    <div class="settings-row">
        <div>
            <h2>Уменьшить движение</h2>
            <p class="muted">Отключает необязательные переходы вне системной настройки.</p>
        </div>
        <label class="switch">
            <input type="checkbox" @bind="_reduceMotion" @bind:after="SaveAsync" />
            <span>Уменьшить движение</span>
        </label>
    </div>
</UiCard>

@if (_storageUnavailable)
{
    <UiStatusBanner Kind="UiStatusKind.Warning" Title="Настройки не удаётся сохранить">
        В текущей вкладке они применятся, но не переживут перезагрузку.
    </UiStatusBanner>
}

<UiCard>
    <h2>Локальные данные</h2>
    <p>Историю посещений и локальные threads можно удалить по отдельности на соответствующих экранах. Удаление не изменяет durable memory.</p>
    <div class="button-row">
        <NavLink class="ui-button ui-button--secondary" href="/history">История посещений</NavLink>
        <NavLink class="ui-button ui-button--ghost" href="/chat">Чаты</NavLink>
    </div>
</UiCard>

@code {
    private string _theme = "system";
    private bool _reduceMotion;
    private bool _storageUnavailable;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _storageUnavailable = !await BrowserState.IsStorageAvailableAsync();
        var preferences = await BrowserState.GetPreferencesAsync();
        _theme = preferences.Theme;
        _reduceMotion = preferences.ReduceMotion;
        await BrowserState.SavePreferencesAsync(preferences);
        await InvokeAsync(StateHasChanged);
    }

    private Task SaveAsync() => BrowserState.SavePreferencesAsync(new(_theme, _reduceMotion)).AsTask();
}
