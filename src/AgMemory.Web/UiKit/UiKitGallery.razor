@page "/ui-kit"

<PageTitle>UI-kit · AgMemory</PageTitle>

<section class="page-header">
    <p class="eyebrow">Компоненты</p>
    <h1>UI-kit AgMemory</h1>
    <p>Первичные CSS-токены и состояния для интерфейса памяти и чата.</p>
</section>

<section class="component-grid" aria-label="Состояния компонентов">
    <UiCard>
        <h2>Кнопки</h2>
        <div class="button-row">
            <button class="ui-button" type="button">Основная</button>
            <button class="ui-button ui-button--secondary" type="button">Вторичная</button>
            <button class="ui-button ui-button--ghost" type="button">Нейтральная</button>
            <button class="ui-button ui-button--danger" type="button">Опасное</button>
            <button class="ui-button" type="button" disabled>Загрузка</button>
        </div>
    </UiCard>
    <UiCard>
        <h2>Статусы</h2>
        <UiStatusBanner Kind="UiStatusKind.Info" Title="Информация">Понятный статус без технических деталей.</UiStatusBanner>
        <UiStatusBanner Kind="UiStatusKind.Success" Title="Готово">Изменение применено.</UiStatusBanner>
        <UiStatusBanner Kind="UiStatusKind.Warning" Title="Нужна настройка">Функция ещё недоступна.</UiStatusBanner>
        <UiStatusBanner Kind="UiStatusKind.Error" Title="Ошибка">Можно повторить действие.</UiStatusBanner>
    </UiCard>
    <UiCard>
        <h2>Поля и метки</h2>
        <label class="field-label" for="kit-input">Название</label>
        <input id="kit-input" class="ui-input" value="Пример значения" />
        <span class="scope-badge">Только локально</span>
        <span class="citation-chip">Источник · 01</span>
    </UiCard>
    <UiCard>
        <h2>Пустое состояние</h2>
        <UiEmptyState Icon="⌁" Title="Пока пусто" Description="Пустые состояния объясняют следующий безопасный шаг." />
    </UiCard>
</section>
