@using static Microsoft.AspNetCore.Components.Web.RenderMode

<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["AgMemory.Web.styles.css"]" />
    <link rel="icon" href="@Assets["favicon.ico"]" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="@Assets["assets/brand/agmemory-icon.svg"]" />
    <link rel="apple-touch-icon" sizes="180x180" href="@Assets["assets/brand/agmemory-icon-180.png"]" />
    <link rel="manifest" href="@Assets["site.webmanifest"]" />
    <meta name="theme-color" content="#4755d6" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <AntiforgeryToken />
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
