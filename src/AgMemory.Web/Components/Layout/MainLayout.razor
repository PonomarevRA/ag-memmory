@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Web

<div class="app-shell">
    <a class="skip-link" href="#main-content">Перейти к содержанию</a>
    <header class="app-header">
        <NavLink class="brand" href="/" Match="NavLinkMatch.All" aria-label="AgMemory — на главную">
            <span class="brand-mark" aria-hidden="true"><img src="assets/brand/agmemory-icon.svg" alt="" /></span>
            <span>AgMemory</span>
        </NavLink>
        <button @ref="_menuToggle" class="header-menu-toggle ui-button ui-button--secondary" type="button" aria-label="Открыть основное меню" aria-expanded="@_menuOpen" aria-controls="primary-navigation" @onclick="ToggleMenuAsync">Меню</button>
        @if (_menuOpen)
        {
            <button class="focus-sentinel" type="button" aria-label="Начало меню" @onfocus="FocusMenuStartAsync"></button>
        }
        <nav id="primary-navigation" class="primary-nav @(_menuOpen ? "primary-nav--open" : string.Empty)" aria-label="Основная навигация" @onkeydown="OnMenuKeyDown">
            <button @ref="_menuClose" class="primary-nav__close ui-icon-button" type="button" aria-label="Закрыть меню" @onclick="CloseMenuAsync">×</button>
            <NavLink href="/chat">Чат</NavLink>
            <NavLink href="/memory-status">Состояние памяти</NavLink>
            <NavLink href="/memory-reader">Читать память</NavLink>
            <NavLink href="/memory-graph">Граф памяти</NavLink>
            <NavLink href="/connect">Подключить агента</NavLink>
            <NavLink href="/about">О проекте</NavLink>
            <NavLink href="/ui-kit">UI-kit</NavLink>
        </nav>
        @if (_menuOpen)
        {
            <button class="focus-sentinel" type="button" aria-label="Конец меню" @onfocus="FocusMenuStartAsync"></button>
        }
        <div class="header-actions">
            <BackButton />
            <HistoryDrawer />
            <NavLink class="ui-icon-button" href="/settings" aria-label="Настройки">⚙</NavLink>
        </div>
    </header>

    <main id="main-content" class="app-main">
        @Body
    </main>

    <footer class="app-footer">
        <span>AgMemory Web · локальная история остаётся в этом браузере</span>
        <NavLink href="/history">История посещений</NavLink>
    </footer>
</div>

@code {
    private bool _menuOpen;
    private ElementReference _menuToggle;
    private ElementReference _menuClose;
    private bool _focusMenuStart;

    private async Task ToggleMenuAsync()
    {
        _menuOpen = !_menuOpen;
        if (_menuOpen) _focusMenuStart = true;
        else await _menuToggle.FocusAsync();
    }

    private async Task CloseMenuAsync()
    {
        _menuOpen = false;
        await _menuToggle.FocusAsync();
    }

    private async Task OnMenuKeyDown(KeyboardEventArgs eventArgs)
    {
        if (eventArgs.Key != "Escape" || !_menuOpen) return;
        _menuOpen = false;
        await InvokeAsync(StateHasChanged);
        await _menuToggle.FocusAsync();
    }

    private Task FocusMenuStartAsync()
    {
        _focusMenuStart = true;
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusMenuStart) return;
        _focusMenuStart = false;
        await _menuClose.FocusAsync();
    }
}

<NavigationTracker />

<div id="blazor-error-ui" data-nosnippet>
    Соединение с интерфейсом потеряно.
    <a href="." class="reload">Перезагрузить</a>
    <span class="dismiss">🗙</span>
</div>
