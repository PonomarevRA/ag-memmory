## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
*.snupkg

# dotenv environment variables file
.env

# Others
~$*
*~
CodeCoverage/
.DS_Store
.idea/
.vs/
TestResults/

# MSBuild Binary and Structured Log
*.binlog

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Node / Vite (AgMemory.Web client)
**/node_modules/
src/AgMemory.Web/wwwroot/dist/

# Native desktop launcher caches and locally built widget companion
**/__pycache__/
*.py[cod]
packaging/widgets/macos/build/

# Local credentials, memory databases, and internal working material
.env.*
!.env.example
appsettings.local.json
appsettings.*.local.json
.agmemory-agent-key
.agmemory-knowledge/
*.lancedb/
!src/AgMemory.Storage.LanceDb/
*.sqlite
!src/Compatibility/Agm.Memory.Sqlite/
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm
*.pem
*.pfx
*.p12
*.key
data-protection/
/agent-activity/
docs/agent-memory/
docs/memory/reviews/
docs/memory/implementation/
outputs/
*.bundle
